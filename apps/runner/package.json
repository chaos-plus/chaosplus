{
  "name": "@chaosplus/runner",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "chaos.plus execution runner: hosts coding-agent sessions and exposes a streaming agent runtime.",
  "scripts": {
    "serve": "bun run src/serve.ts",
    "dev": "bun run src/cli.ts",
    "demo": "bun run src/cli.ts --runtime claude",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "format": "prettier --write \"src/**/*.ts\""
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.35",
    "@anthropic-ai/claude-agent-sdk": "^0.3.224",
    "@mastra/core": "^1.57.0",
    "@openai/codex-sdk": "^0.147.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "prettier": "^3.9.6",
    "typescript": "^7.0.2"
  },
  "packageManager": "bun@1.3.12",
  "engines": {
    "node": ">=20"
  }
}
